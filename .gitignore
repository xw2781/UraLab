server-components/src/arcrho_orchestrator/instances/

# Editor and agent-local state
# .claude/settings.json is tracked: it carries the shared agent hooks, and a
# hook that only exists on one machine cannot keep two machines in sync.
# settings.local.json stays ignored — that is the per-machine override file.
.claude/*
!.claude/settings.json
# .claude/skills holds this repo's shared agent skills, so it is tracked too.
!.claude/skills/
!.claude/skills/**
.idea/
.vscode/
*.swp
*.swo
*.bak

# Jupyter
.ipynb_checkpoints/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# Repo-local test tooling installed with pip --target; never committed.
.pytest-tools/
